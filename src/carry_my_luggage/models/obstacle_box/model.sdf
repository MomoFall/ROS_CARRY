<?xml version="1.0"?>
<!-- Carton de 40 cm posé entre le robot et l'opérateur (test de l'évitement d'obstacles). -->
<sdf version="1.6">
  <model name="obstacle_box">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <pose>0 0 0.2 0 0 0</pose>
        <geometry><box><size>0.4 0.4 0.4</size></box></geometry>
      </collision>
      <visual name="visual">
        <pose>0 0 0.2 0 0 0</pose>
        <geometry><box><size>0.4 0.4 0.4</size></box></geometry>
        <material><ambient>0.5 0.35 0.15 1</ambient><diffuse>0.75 0.55 0.3 1</diffuse></material>
      </visual>
    </link>
  </model>
</sdf>
